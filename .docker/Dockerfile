FROM python:3.13-slim-bookworm AS python-base
FROM node:24-bookworm-slim AS img-base

# Arguments
ARG USER=big-data-labs
ARG USER_HOME=/home/$USER
ARG VOLUME=/app
ARG SHELL=/bin/bash

COPY --from=python-base /usr/local/ /usr/local/
RUN ldconfig
RUN pip3 install --upgrade pip

RUN apt-get update
RUN npm install -g npm

# Install OS utilities
RUN apt-get install -y locales \
    && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen
RUN apt-get install -y sudo lsb-release git curl zip unzip jq libsqlite3-0

# Install VSCode extensions dependencies
RUN pip3 install pylint yapf cfn-lint cfn-lint-serverless
RUN npm install -g @anthropic-ai/claude-code \
    && node "$(npm root -g)/@anthropic-ai/claude-code/install.cjs" \
    && claude --version

# Install CLI utilities
RUN case "$(dpkg --print-architecture)" in \
        "amd64") AWSCLI_ARCH="x86_64" ;; \
        "arm64"|"aarch64") AWSCLI_ARCH="aarch64" ;; \
        *) echo "Unsupported architecture" && exit 1 ;; \
    esac; \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-${AWSCLI_ARCH}.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && apt-get install -y less

# Install Serverless framework + plugins
RUN npm install -g serverless

# Set up non root user
RUN echo "$USER ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
RUN useradd -ms $SHELL $USER
RUN mkdir -p $VOLUME \
    && chown -R $USER:$USER $VOLUME

# Let non-root user self-update global npm packages (serverless, claude-code) at runtime
RUN chown -R $USER:$USER /usr/local/lib/node_modules /usr/local/bin

# cfn-lint: ignore W3005 (redundant DependsOn already implied by GetAtt)
RUN echo "ignore_checks:" > "$USER_HOME/.cfnlintrc" \
    && echo "  - W3005" >> "$USER_HOME/.cfnlintrc" \
    && chown $USER:$USER "$USER_HOME/.cfnlintrc"

# Preserve bash history
RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
    && echo $SNIPPET >> "/root/.bashrc" \
    && mkdir /commandhistory \
    && touch /commandhistory/.bash_history \
    && chown -R $USER /commandhistory \
    && echo $SNIPPET >> "$USER_HOME/.bashrc"

USER $USER

######## LABS IMAGE ########
FROM img-base AS img-labs
USER root
# UTF-8 for Java 17, Python and the terminal (Java 17 takes its default charset from the locale)
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
# OS packages of the labs, with a fresh package index in the same layer: this stage is often
# rebuilt weeks after img-base, and a stale index makes apt-get install fail with 404
#   postgresql-client: psql, to load and query the local PostgreSQL service
#   graphviz: architecture diagrams of the labs, generated by docs/architecture.py
#   openjdk-17-jre-headless: Spark runs on the JVM (Java 17, the same as AWS Glue 6.0)
RUN apt-get update \
    && apt-get install -y postgresql-client graphviz openjdk-17-jre-headless \
    && ln -s "$(dirname "$(dirname "$(readlink -f "$(which java)")")")" /usr/lib/jvm/java \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java
# Data generator and lab scripts
RUN pip3 install --no-cache-dir boto3 Faker pytest pytest-cov diagrams
# PySpark, pandas, the Jupyter kernel, the PostgreSQL driver and the AWS Glue library for the Spark labs.
# PySpark is pinned to the Spark of AWS Glue 6.0 (Spark 4.1.1, Python 3.13), so lab 9 runs locally
# and on Glue with the same Spark; an unpinned pip install takes the newest release (4.2.x).
ARG PYSPARK_VERSION=4.1.1
RUN pip3 install --no-cache-dir "pyspark==${PYSPARK_VERSION}" 'pandas<3' 'pyarrow>=18' ipykernel \
    'psycopg[binary]' awsgluedataplanepython==6.0.0 \
    && python3 -c "import pyspark, pandas, pyarrow, psycopg, awsglue; print('pyspark', pyspark.__version__)" \
    && java -version
# Local JupyterHub on port 8888: the hub, JupyterLab for the notebooks and the proxy in front of them
RUN pip3 install --no-cache-dir 'jupyterhub==6.1.1' 'jupyterlab==4.6.4' \
    && npm install -g configurable-http-proxy@5.3.0 \
    && chown -R $USER:$USER /usr/local/lib/node_modules /usr/local/bin \
    && jupyterhub --version && configurable-http-proxy --version
COPY jupyterhub_config.py /etc/jupyterhub/jupyterhub_config.py
RUN pip3 install confluent-kafka==2.16.0
EXPOSE 8888
USER $USER
